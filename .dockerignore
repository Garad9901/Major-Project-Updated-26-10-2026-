# Applies to builds whose context is the repository root — currently only
# docker/Dockerfile.caddy, which needs frontend/ to compile the static bundle
# and nothing else. Everything not required by that build is excluded, both to
# keep secrets out of the image and to keep the build context small.

# --- secrets: must never enter an image layer --------------------------------
.env
.env.*
!.env.example

# --- version control / editor -------------------------------------------------
.git
.gitignore
.vscode
.idea
.claude

# --- other build contexts (not needed to compile the frontend) ----------------
backend/
sync_worker/
db/

# --- dependencies and build output --------------------------------------------
**/node_modules
**/dist
**/__pycache__
**/*.py[cod]

# --- generated artefacts and documentation ------------------------------------
copyright_submission/
scripts/
*.md
LICENSE

# frontend tests — dev-only, never shipped (the caddy image builds from repo root)
frontend/src/__*__.jsx
# The hook test harness. Nothing imports it from the app, so the bundler
# already drops it — but it reaches into React's private internals to swap
# the hook dispatcher, and that has no business inside a production image.
frontend/src/__testutils__/
frontend/src/**/*.test.jsx
