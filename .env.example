# Copy to .env and adjust as needed.

# Postgres
POSTGRES_DB=college_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# The hostname or IP the server is reached at over HTTPS. Set this to your
# server's LAN IP (e.g. 192.168.1.50) so CSRF/HTTPS trust it. 'localhost' is
# fine when testing on the server itself.
SERVER_HOST=localhost
# Cookies are marked Secure (HTTPS-only) by default. Only set false if you
# deliberately run without the HTTPS proxy.
COOKIE_SECURE=true

# Staff login created automatically on first startup (change these for real use)
STAFF_USERNAME=staff
STAFF_PASSWORD=staffpass123

# THE BUILT-IN DEMO COLLEGE. Invented data — 8 departments, 7 faculty, 10
# programs, 8 courses and the fees and timetables that hang off them.
#
# TRUE HERE IS DELIBERATE, AND IS SAFE ONLY BECAUSE OF WHAT THIS FILE IS.
# .env.example is the LOCAL DEVELOPMENT / EVALUATION path: it ships with example
# passwords, so it can never be a production configuration. Something to query
# out of the box is exactly what that path wants.
#
# A REAL DEPLOYMENT DOES NOT COME FROM THIS FILE. It comes from
# `sh scripts/setup.sh`, which generates real secrets and writes
# SEED_DEMO_DATA=false. If you are setting up a server for actual users and you
# are reading this line, you are on the wrong path — see DEPLOYMENT.md.
#
# --if-empty guards it either way: it can never overwrite records you loaded.
SEED_DEMO_DATA=true

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=college_docs

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# How long to wait for the model to produce its FIRST token, in seconds.
#
# On a CPU-only machine the model must read the whole prompt before it can emit
# anything, and a retrieval-heavy question sends about 2,000 tokens of retrieved
# text. That read alone can exceed the built-in 120s default and the question
# then fails with "The AI service is temporarily unavailable" even though
# nothing is actually broken — which is exactly what happened on this laptop
# with the faculty development profiles.
#
# 240 is chosen to stay comfortably BELOW the production GUNICORN_TIMEOUT of
# 300s; raising this above that would let gunicorn kill the worker before the
# HTTP client ever gives up. Raise both together, or neither.
# On a GPU machine this can go back down — first tokens arrive in seconds.
OLLAMA_READ_TIMEOUT=240

# The language model all four agents use, and the one the stack downloads on
# first start. This is the single place to change the model.
#   qwen2.5:7b  (default) ~4.7 GB — best answer quality
#   qwen2.5:3b            ~1.9 GB — smaller/faster, lower quality (good on modest hardware)
#   qwen2.5:1.5b         ~1 GB   — smallest/fastest, noticeably weaker
# After changing this, run: docker compose up -d   (it will download the new model)
LLM_MODEL=qwen2.5:7b
# Optional: override the model for a single agent (defaults to LLM_MODEL if unset)
# SQL_AGENT_MODEL=qwen2.5:7b
# ROUTER_MODEL=qwen2.5:7b
# SYNTHESIS_MODEL=qwen2.5:7b
# VERIFICATION_MODEL=qwen2.5:7b
#
# Measured 18 Aug 2026 (docs/LATENCY.md): SYNTHESIS_MODEL=qwen2.5:3b is 1.98x
# faster end to end (47.4s -> 24.0s mean) but scores lower on 4 of 10
# ground-truth questions, worst on ones where the database returns no rows.
# The recommendation is to leave it on 7b; the knob is here to A/B yourself.

# Ollama context window, in tokens, applied to every chat call.
#
# NOT just a performance setting. Ollama silently discards the FRONT of any
# prompt longer than this, and the front of a synthesis prompt is the system
# prompt — including the rules that stop poisoned database content from
# redirecting the model. Ollama's own default with no GPU is 4096, and the
# largest real prompt measured was 3,365 tokens, so the old margin was 18%.
# Measured cost of doubling it on this deployment: none.
# OLLAMA_NUM_CTX=8192

# CPU threads for inference. 0 (default) lets Ollama choose from the visible
# core count. On the reference machine (Core Ultra 9 185H) setting this to 14
# measured 1.12x faster prompt reading — a real but small effect, and specific
# to that CPU. See docs/LATENCY.md before setting it.
# OLLAMA_NUM_THREAD=0

# Inline answer verification: fact-checks each answer against the source data
# before/after showing it. Roughly DOUBLES response time (measured +98% on a
# warm 7b model). Set false if speed matters more than accuracy for your users.
ENABLE_VERIFICATION=true

# LLM admission control — how many questions may occupy the model at once, and
# how long a queued request waits before being told the assistant is busy.
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT=120

# sync_worker
SYNC_WORKER_POLL_INTERVAL_SECONDS=30

# rag_agent_ro (read-only DB role, see db/sql/create_rag_agent_ro.sql)
RAG_AGENT_RO_HOST=postgres
RAG_AGENT_RO_PORT=5432
RAG_AGENT_RO_DB=college_rag
RAG_AGENT_RO_USER=rag_agent_ro
RAG_AGENT_RO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
